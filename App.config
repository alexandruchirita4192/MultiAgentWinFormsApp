<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<configSections>
		<section name="agentConfigurations" type="System.Configuration.NameValueSectionHandler" />
		<section name="baseAgentConfigurations" type="System.Configuration.NameValueSectionHandler" />
		<section name="agentPresetConfigurations" type="System.Configuration.NameValueSectionHandler" />
	</configSections>
    <appSettings>
        <!-- Choose back-end between 'Copilot' and 'OpenAI' and specify required token/API key-->
        <add key="LLMBackend" value="OpenAI"/>
        <add key="GitHubToken" value="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"/>
        <add key="OpenAIKey" value="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"/>
        <add key="OpenAIModel" value="gpt-3.5-turbo"/>
        <!-- Modes: SinglePass, Loop -->
        <add key="OrchestrationMode" value="SinglePass"/>
		<add key="MainFormat" value="{0}{4}{1} `{2}`:{4}```{3}```"/>
    </appSettings>
	<!-- Base agent key-value pairs: -->
	<baseAgentConfigurations>
		<add key="SinglePassPrompt" value="Review the following file and add fix points as specified below." />
		<add key="LoopPrompt" value="Modify the following file to improve it as specified below. If the file has no improvements that can be made based on the requirements specified below then leave it unchanged." />
		<!-- MainFormat Arguments: {0}=Prompt, {1}="File", {2}=fileName, {3}=content, {4}=Environment.NewLine-->
		<!-- Default MainFormat: $"{Prompt}{Environment.NewLine}File `{fileName}`:{Environment.NewLine}```{content}```" -->
		<add key="MainFormat" value="{0}{4}{1} `{2}`:{4}```{3}```" />
	</baseAgentConfigurations>
	<agentPresetConfigurations>
		<add key="Delta Force Team" value="Forex Quant Strategist::Design robust FX hypotheses and market regime tags for major/minor symbols; include risk controls and session-aware logic.||Python ONNX Trainer::Propose Python training pipelines, feature engineering, and ONNX export validation for forex models.||MT5 EA Engineer::Implement Expert Advisor architecture for MT5 with configurable symbol routing, magic numbers, and trade lifecycle safety checks.||Backtest Commander::Define repeatable walk-forward and cross-symbol backtests with realistic spread/slippage assumptions and result reports.||Parameter Optimizer::Generate optimization plans for EA/ML hyperparameters, constraints, and stop criteria to avoid overfitting.||Parallel Execution Coordinator::Plan parallel runs across symbols/timeframes with isolated state, unique magic numbers, and aggregated metrics." />
		<add key="Army" value="Daily Finance Analyst::Summarize macro and forex market context in clear, actionable daily notes.||Operations Planner::Break large automation goals into weekly tasks, priorities, and dependencies.||Risk & Compliance Officer::Review leverage, drawdown, and position-sizing rules to keep systems safe for daily operation.||Data Quality Sentinel::Check data feeds, missing candles, timezone alignment, and feature drift before model usage.||Personal Productivity Officer::Turn objectives into routines, reminders, and measurable daily checkpoints across domains.||Knowledge Archivist::Capture experiment outcomes, optimized parameters, and lessons learned for future iteration." />
	</agentPresetConfigurations>

	<!-- Agents defined by name (key) and with a prompt (value): -->
    <agentConfigurations>
        <add key="Add Notice Agent" value="Insert a comment notice to the current code file if it's missing that `The code was created in whole or in part by GenAI`:" />
		<add key="Coding Principles Reviewer Agent" value="Please check and fix the following code for programming principles like: simplicity, readability, SOLID principles, OOP principles, OOD principles:" />
		<add key="Find and Fix Bugs Agent" value="Find and fix bugs in this code, improving robustness:" />
		<add key="Multi-threading Expert Agent" value="Find and fix any concurrency issues or multi-threading safety issues:" />
		<add key="Method Checker Agent" value="Check and fix code branches proper corner cases, proper values at limits, missing exception handling or missing default values:" />
		<add key="Unit Test Agent" value="Generate NUnit unit tests for this code in an appended class:" />
    </agentConfigurations>
</configuration>
